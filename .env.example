MONGODB_URI=mongodb://127.0.0.1:27018/fleet_demo?replicaSet=fleet-demo
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
PORT=3001
ORIGIN=http://localhost:5173

# OPENAI_API_KEY=            <- put the real key in .env, never here
# OPENAI_MODEL=gpt-4o-mini
SUPPORT_AI_ENABLED=false


# --- Flight data (AviationStack) ------------------------------------------
# Optional. Without a key, flight status shows "no provider configured" and the
# only flight behaviour is the clearly-labelled simulated delay.
# Put the real key in .env, never here.
# AVIATIONSTACK_API_KEY=
#
# The AviationStack FREE plan is HTTP-only, which sends the key in plaintext.
# HTTPS is the default; set this to true ONLY for a throwaway free-tier key.
# AVIATIONSTACK_ALLOW_INSECURE_HTTP=false

# --- Location: UK address search, routing and map tiles (Geoapify) ---------
# All optional. Without them the app still works: manual map pins and the
# labelled UK test points remain available, and address search reports itself
# as unconfigured rather than failing silently.
# Put real keys in .env, never here.
#
# Server-side only — used for address search and road travel estimates.
# GEOAPIFY_API_KEY=
#
# Browser-visible (VITE_ vars are bundled into the client). Use a SEPARATE,
# origin-restricted key for tiles — never reuse the server key above.
# VITE_GEOAPIFY_MAP_KEY=

# Passenger contacts are restricted to @example.invalid by default, so no real
# person can be contacted by accident. Set true only for a demo where realistic
# addresses matter. Nothing is sent either way - no mail provider is installed.
ALLOW_REAL_CONTACTS=false
