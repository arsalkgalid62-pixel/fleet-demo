{
  "name": "fleet-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n mongo,api,web \"npm run db:local\" \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "db:local": "tsx scripts/local-mongo.ts",
    "db:setup": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "test": "tsx --test tests/*.test.ts",
    "ui:smoke": "vite build --ssr scripts/ui-smoke.jsx --outDir dist-smoke --logLevel error && node dist-smoke/ui-smoke.js",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
