# Merge the relevant lines into your local .env. Never copy secrets into example files.
# Server-side UK address search and road travel estimates.
GEOAPIFY_API_KEY=
# Browser-visible map key: use a separate key restricted to your app's origins.
# Geoapify tiles need this key and carry Geoapify / OpenStreetMap attribution.
VITE_GEOAPIFY_MAP_KEY=
